rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allowlist of authorized team member emails (lowercase).
    // Update this list with your 4–5 team member emails before deploying rules.
    function isAllowedTeamMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          // Example team emails — replace with your real team emails:
          // 'owner@yourdealership.com',
          // 'manager@yourdealership.com',
          // 'tech1@yourdealership.com',
          // 'tech2@yourdealership.com',
          // 'sales@yourdealership.com'
        ];
    }

    // Alternatively, manage allowed users dynamically in /allowedUsers/{lowercaseEmail}
    function isInAllowedUsersCollection() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    function isAuthorized() {
      return isAllowedTeamMember() || isInAllowedUsersCollection();
    }

    // Vehicles collection & activity history subcollection
    match /vehicles/{vehicleId} {
      allow read, create, update, delete: if isAuthorized();

      match /history/{entryId} {
        allow read, create: if isAuthorized();
        allow update, delete: if false; // Audit log entries are append-only
      }
    }

    // Allowed users directory (readable by signed-in user to verify access)
    match /allowedUsers/{email} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false; // Managed via Firebase Console or Admin SDK
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
